// DFS traversal
void DFS(int vertex) {
    Node* temp;

    visited[vertex] = 1;

    printf("%d ", vertex);

    temp = adjList[vertex];

    while (temp != NULL) {
        if (!visited[temp->vertex]) {
            DFS(temp->vertex);
        }

        temp = temp->next;
    }
}

